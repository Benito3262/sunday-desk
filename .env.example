# Copy to .env.local — never commit the real file.

# From https://web3.binance.com/en/dev-portal after you register the hackathon.
# The secret stays on the server. Do not put it in any NEXT_PUBLIC_ variable.
BINANCE_WEB3_API_KEY=
BINANCE_WEB3_API_SECRET=

# Free project id from https://cloud.reown.com (WalletConnect Cloud).
# Needed for the QR code that connects a phone wallet. Injected wallets
# (MetaMask, Trust, Binance Wallet in-app browser) work without it.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Public URL of this deployment, no trailing slash. Used in wallet deep links.
NEXT_PUBLIC_APP_URL=http://localhost:3000
